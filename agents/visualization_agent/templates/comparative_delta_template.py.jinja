#!/usr/bin/env python3
"""
Standalone Comparative Milestone Delta Plotter
Compares Baseline vs Candidate benchmark JSON datasets.
Decoupled plotting script generated by MotionCorr Visualization Agent.
"""

import argparse
import json
import sys
from pathlib import Path
from typing import Dict, List, Optional, Tuple


def parse_benchmark_json(json_path: Path) -> Dict[int, Dict]:
    with open(json_path, "r", encoding="utf-8") as f:
        data = json.load(f)
    cases = data.get("cases", [])
    return {c.get("threads", 1): c for c in cases}


def plot_with_svg(
    title: str,
    threads: List[int],
    base_times: List[float],
    cand_times: List[float],
    speedups: List[float],
    base_label: str,
    cand_label: str,
    out_svg: Path
) -> None:
    width, height = 850, 480
    margin_l, margin_r, margin_t, margin_b = 80, 80, 60, 60
    plot_w = width - margin_l - margin_r
    plot_h = height - margin_t - margin_b

    max_th = max(threads) if threads else 10
    max_t = max(base_times + cand_times) * 1.1 if (base_times or cand_times) else 100.0
    max_sp = max(speedups) * 1.2 if speedups else 2.0

    def x_c(th): return margin_l + (th / max_th) * plot_w
    def y_t(t): return margin_t + plot_h - (t / max_t) * plot_h
    def y_s(s): return margin_t + plot_h - (s / max_sp) * plot_h

    lines = [
        f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {width} {height}" width="{width}" height="{height}">',
        f'  <rect width="{width}" height="{height}" fill="#ffffff" rx="8"/>',
        f'  <text x="{width / 2}" y="32" font-family="sans-serif" font-size="16" font-weight="bold" fill="#0f172a" text-anchor="middle">{title}</text>',
        f'  <rect x="{margin_l}" y="{margin_t}" width="{plot_w}" height="{plot_h}" fill="#f8fafc" stroke="#e2e8f0"/>',
    ]

    for i in range(6):
        t_val = (max_t / 5) * i
        y = y_t(t_val)
        lines.append(f'  <line x1="{margin_l}" y1="{y:.1f}" x2="{margin_l + plot_w}" y2="{y:.1f}" stroke="#e2e8f0"/>')
        lines.append(f'  <text x="{margin_l - 10}" y="{y + 4:.1f}" font-family="sans-serif" font-size="10" fill="#64748b" text-anchor="end">{t_val:.1f}s</text>')
        s_val = (max_sp / 5) * i
        y_sp = y_s(s_val)
        lines.append(f'  <text x="{margin_l + plot_w + 10}" y="{y_sp + 4:.1f}" font-family="sans-serif" font-size="10" fill="#059669" text-anchor="start">{s_val:.1f}x</text>')

    for th in threads:
        x = x_c(th)
        lines.append(f'  <line x1="{x:.1f}" y1="{margin_t + plot_h}" x2="{x:.1f}" y2="{margin_t + plot_h + 5}" stroke="#64748b"/>')
        lines.append(f'  <text x="{x:.1f}" y="{margin_t + plot_h + 20}" font-family="sans-serif" font-size="11" fill="#334155" text-anchor="middle">{th} th</text>')

    # Baseline curve (red)
    pts_base = " ".join(f"{x_c(th):.1f},{y_t(t):.1f}" for th, t in zip(threads, base_times))
    lines.append(f'  <polyline points="{pts_base}" fill="none" stroke="#dc2626" stroke-width="2.5"/>')
    for th, t in zip(threads, base_times):
        lines.append(f'  <circle cx="{x_c(th):.1f}" cy="{y_t(t):.1f}" r="4.0" fill="#dc2626" stroke="#ffffff"/>')

    # Candidate curve (blue)
    pts_cand = " ".join(f"{x_c(th):.1f},{y_t(t):.1f}" for th, t in zip(threads, cand_times))
    lines.append(f'  <polyline points="{pts_cand}" fill="none" stroke="#2563eb" stroke-width="2.5"/>')
    for th, t in zip(threads, cand_times):
        lines.append(f'  <circle cx="{x_c(th):.1f}" cy="{y_t(t):.1f}" r="4.0" fill="#2563eb" stroke="#ffffff"/>')

    # Relative Speedup curve (green)
    pts_sp = " ".join(f"{x_c(th):.1f},{y_s(s):.1f}" for th, s in zip(threads, speedups))
    lines.append(f'  <polyline points="{pts_sp}" fill="none" stroke="#059669" stroke-width="2.5" stroke-dasharray="5,3"/>')
    for th, s in zip(threads, speedups):
        lines.append(f'  <circle cx="{x_c(th):.1f}" cy="{y_s(s):.1f}" r="4.0" fill="#059669" stroke="#ffffff"/>')

    # Legend
    leg_x = margin_l + 15
    leg_y = margin_t + 20
    lines.append(f'  <line x1="{leg_x}" y1="{leg_y}" x2="{leg_x + 20}" y2="{leg_y}" stroke="#dc2626" stroke-width="2.5"/>')
    lines.append(f'  <text x="{leg_x + 28}" y="{leg_y + 4}" font-family="sans-serif" font-size="11" font-weight="bold" fill="#dc2626">{base_label}</text>')
    lines.append(f'  <line x1="{leg_x + 180}" y1="{leg_y}" x2="{leg_x + 200}" y2="{leg_y}" stroke="#2563eb" stroke-width="2.5"/>')
    lines.append(f'  <text x="{leg_x + 208}" y="{leg_y + 4}" font-family="sans-serif" font-size="11" font-weight="bold" fill="#2563eb">{cand_label}</text>')
    lines.append(f'  <line x1="{leg_x + 360}" y1="{leg_y}" x2="{leg_x + 380}" y2="{leg_y}" stroke="#059669" stroke-width="2.5" stroke-dasharray="5,3"/>')
    lines.append(f'  <text x="{leg_x + 388}" y="{leg_y + 4}" font-family="sans-serif" font-size="11" font-weight="bold" fill="#059669">Relative Speedup (x)</text>')

    lines.append(f'  <text x="{margin_l + plot_w / 2}" y="{height - 15}" font-family="sans-serif" font-size="12" font-weight="600" text-anchor="middle">OpenMP Thread Count</text>')
    lines.append(f'  <text x="25" y="{margin_t + plot_h / 2}" font-family="sans-serif" font-size="12" font-weight="600" text-anchor="middle" transform="rotate(-90 25 {margin_t + plot_h / 2})">Execution Time (s)</text>')
    lines.append(f'  <text x="{width - 20}" y="{margin_t + plot_h / 2}" font-family="sans-serif" font-size="12" font-weight="600" fill="#059669" text-anchor="middle" transform="rotate(90 {width - 20} {margin_t + plot_h / 2})">Relative Speedup (x)</text>')

    lines.append('</svg>')
    out_svg.parent.mkdir(parents=True, exist_ok=True)
    with open(out_svg, "w", encoding="utf-8") as f:
        f.write("\n".join(lines))


def main():
    parser = argparse.ArgumentParser(description="Standalone Comparative Milestone Delta Plotter")
    parser.add_argument("--baseline", required=True, type=Path, help="Path to baseline benchmark JSON")
    parser.add_argument("--candidate", required=True, type=Path, help="Path to candidate benchmark JSON")
    parser.add_argument("--base-label", default="Baseline", help="Label for baseline series")
    parser.add_argument("--cand-label", default="Optimized", help="Label for candidate series")
    parser.add_argument("--out-dir", type=Path, default=Path("plots"), help="Output directory for plots")
    parser.add_argument("--title", type=str, default="MotionCorr Optimization Delta Comparison", help="Plot title")
    args = parser.parse_args()

    base_map = parse_benchmark_json(args.baseline)
    cand_map = parse_benchmark_json(args.candidate)

    common_threads = sorted(set(base_map.keys()) & set(cand_map.keys()))
    if not common_threads:
        print("Error: No matching thread configurations between baseline and candidate.", file=sys.stderr)
        sys.exit(1)

    base_times = [base_map[th].get("mean_wall_time_sec", 0.0) for th in common_threads]
    cand_times = [cand_map[th].get("mean_wall_time_sec", 0.0) for th in common_threads]
    speedups = [bt / max(1e-6, ct) for bt, ct in zip(base_times, cand_times)]

    args.out_dir.mkdir(parents=True, exist_ok=True)
    out_svg = args.out_dir / f"{args.candidate.stem}_vs_{args.baseline.stem}_comparison.svg"
    plot_with_svg(args.title, common_threads, base_times, cand_times, speedups, args.base_label, args.cand_label, out_svg)
    print(f"[Comparative Plotter] Generated SVG: {out_svg}")


if __name__ == "__main__":
    main()
