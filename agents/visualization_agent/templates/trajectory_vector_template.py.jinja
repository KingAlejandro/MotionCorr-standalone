#!/usr/bin/env python3
"""
Standalone 2D Motion Trajectory Plotter
Decoupled plotting script generated by MotionCorr Visualization Agent.
"""

import argparse
import math
import sys
from pathlib import Path
from typing import Dict, List, Optional, Tuple


def parse_star_trajectory(star_path: Path) -> Tuple[List[int], List[float], List[float]]:
    frames, shift_x, shift_y = [], [], []
    with open(star_path, "r", encoding="utf-8") as f:
        lines = [line.strip() for line in f if line.strip() and not line.startswith("#")]

    in_loop = False
    headers = []
    for line in lines:
        if line.startswith("loop_"):
            in_loop = True
            headers = []
            continue
        if in_loop and line.startswith("_rln"):
            headers.append(line.split()[0])
            continue
        if in_loop and headers and not line.startswith("_"):
            parts = line.split()
            if len(parts) >= len(headers):
                row = dict(zip(headers, parts))
                if "_rlnMicrographShiftX" in row and "_rlnMicrographShiftY" in row:
                    f_idx = int(row.get("_rlnMicrographFrameNumber", len(frames) + 1))
                    sx = float(row["_rlnMicrographShiftX"])
                    sy = float(row["_rlnMicrographShiftY"])
                    frames.append(f_idx)
                    shift_x.append(sx)
                    shift_y.append(sy)

    if not frames:
        # Fallback heuristic parser for simple 2/3 column tables
        for line in lines:
            parts = line.split()
            if len(parts) >= 2 and all(p.replace(".", "", 1).replace("-", "", 1).isdigit() for p in parts[:2]):
                frames.append(len(frames) + 1)
                shift_x.append(float(parts[0]))
                shift_y.append(float(parts[1]))

    return frames, shift_x, shift_y


def plot_with_matplotlib(
    title: str,
    frames: List[int],
    shift_x: List[float],
    shift_y: List[float],
    out_png: Path
) -> bool:
    try:
        import matplotlib.pyplot as plt
        import matplotlib
        matplotlib.use("Agg")
    except ImportError:
        return False

    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(11, 4.5), dpi=150)

    # Subplot 1: Frame vs Shift Curves
    ax1.plot(frames, shift_x, label="Shift X", color="#2563eb", marker="o", linewidth=2.0)
    ax1.plot(frames, shift_y, label="Shift Y", color="#059669", marker="s", linewidth=2.0)
    ax1.axhline(0, color="#94a3b8", linestyle="--", linewidth=1.0)
    ax1.set_xlabel("Movie Frame Index", fontsize=10, fontweight="bold")
    ax1.set_ylabel("Displacement (pixels)", fontsize=10, fontweight="bold")
    ax1.set_title("Shift vs Frame Number", fontsize=11, fontweight="bold")
    ax1.legend()
    ax1.grid(True, linestyle="--", alpha=0.5)

    # Subplot 2: 2D Spatial Motion Trajectory Path
    ax2.plot(shift_x, shift_y, color="#7c3aed", marker="o", linewidth=2.0, alpha=0.8)
    for i, (x, y) in enumerate(zip(shift_x, shift_y)):
        ax2.annotate(f"F{frames[i]}", (x, y), textcoords="offset points", xytext=(0, 5), ha="center", fontsize=8)
    ax2.set_xlabel("X Shift (pixels)", fontsize=10, fontweight="bold")
    ax2.set_ylabel("Y Shift (pixels)", fontsize=10, fontweight="bold")
    ax2.set_title("2D Cumulative Motion Trajectory", fontsize=11, fontweight="bold")
    ax2.grid(True, linestyle="--", alpha=0.5)

    fig.suptitle(title, fontsize=13, fontweight="bold", y=1.02)
    plt.tight_layout()
    out_png.parent.mkdir(parents=True, exist_ok=True)
    plt.savefig(out_png, bbox_inches="tight")
    plt.close()
    return True


def plot_with_svg(
    title: str,
    frames: List[int],
    shift_x: List[float],
    shift_y: List[float],
    out_svg: Path
) -> None:
    width, height = 800, 480
    margin_l, margin_r, margin_t, margin_b = 60, 40, 60, 60
    plot_w = width - margin_l - margin_r
    plot_h = height - margin_t - margin_b

    all_shifts = shift_x + shift_y
    span = max(abs(min(all_shifts, default=0.0)), abs(max(all_shifts, default=1.0)), 1.0) * 1.2
    max_frame = max(frames) if frames else len(shift_x)

    def x_c(f): return margin_l + ((f - 1) / max(1, max_frame - 1)) * plot_w
    def y_c(s): return margin_t + plot_h / 2 - (s / span) * (plot_h / 2)

    lines = [
        f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {width} {height}" width="{width}" height="{height}">',
        f'  <rect width="{width}" height="{height}" fill="#ffffff" rx="8"/>',
        f'  <text x="{width / 2}" y="32" font-family="sans-serif" font-size="16" font-weight="bold" fill="#0f172a" text-anchor="middle">{title}</text>',
        f'  <rect x="{margin_l}" y="{margin_t}" width="{plot_w}" height="{plot_h}" fill="#f8fafc" stroke="#e2e8f0"/>',
        f'  <line x1="{margin_l}" y1="{margin_t + plot_h / 2:.1f}" x2="{margin_l + plot_w}" y2="{margin_t + plot_h / 2:.1f}" stroke="#94a3b8"/>',
    ]

    for val in [-span * 0.75, -span * 0.5, span * 0.5, span * 0.75]:
        y = y_c(val)
        lines.append(f'  <line x1="{margin_l}" y1="{y:.1f}" x2="{margin_l + plot_w}" y2="{y:.1f}" stroke="#e2e8f0"/>')
        lines.append(f'  <text x="{margin_l - 8}" y="{y + 4:.1f}" font-family="sans-serif" font-size="10" fill="#64748b" text-anchor="end">{val:+.1f} px</text>')

    for f in frames[::max(1, len(frames) // 8)]:
        x = x_c(f)
        lines.append(f'  <line x1="{x:.1f}" y1="{margin_t + plot_h}" x2="{x:.1f}" y2="{margin_t + plot_h + 5}" stroke="#64748b"/>')
        lines.append(f'  <text x="{x:.1f}" y="{margin_t + plot_h + 18}" font-family="sans-serif" font-size="10" fill="#64748b" text-anchor="middle">F{f}</text>')

    # Shift X polyline
    pts_x = " ".join(f"{x_c(f):.1f},{y_c(sx):.1f}" for f, sx in zip(frames, shift_x))
    lines.append(f'  <polyline points="{pts_x}" fill="none" stroke="#2563eb" stroke-width="2.5"/>')
    for f, sx in zip(frames, shift_x):
        lines.append(f'  <circle cx="{x_c(f):.1f}" cy="{y_c(sx):.1f}" r="3.5" fill="#2563eb" stroke="#ffffff"/>')

    # Shift Y polyline
    pts_y = " ".join(f"{x_c(f):.1f},{y_c(sy):.1f}" for f, sy in zip(frames, shift_y))
    lines.append(f'  <polyline points="{pts_y}" fill="none" stroke="#059669" stroke-width="2.5"/>')
    for f, sy in zip(frames, shift_y):
        lines.append(f'  <circle cx="{x_c(f):.1f}" cy="{y_c(sy):.1f}" r="3.5" fill="#059669" stroke="#ffffff"/>')

    # Legend
    lines.append(f'  <line x1="{margin_l + 20}" y1="{margin_t + 20}" x2="{margin_l + 40}" y2="{margin_t + 20}" stroke="#2563eb" stroke-width="2.5"/>')
    lines.append(f'  <text x="{margin_l + 48}" y="{margin_t + 24}" font-family="sans-serif" font-size="11" font-weight="bold" fill="#2563eb">Shift X (px)</text>')
    lines.append(f'  <line x1="{margin_l + 160}" y1="{margin_t + 20}" x2="{margin_l + 180}" y2="{margin_t + 20}" stroke="#059669" stroke-width="2.5"/>')
    lines.append(f'  <text x="{margin_l + 188}" y="{margin_t + 24}" font-family="sans-serif" font-size="11" font-weight="bold" fill="#059669">Shift Y (px)</text>')

    lines.append(f'  <text x="{margin_l + plot_w / 2}" y="{height - 15}" font-family="sans-serif" font-size="12" font-weight="600" text-anchor="middle">Movie Frame Index</text>')
    lines.append(f'  <text x="18" y="{margin_t + plot_h / 2}" font-family="sans-serif" font-size="12" font-weight="600" text-anchor="middle" transform="rotate(-90 18 {margin_t + plot_h / 2})">Displacement (pixels)</text>')
    lines.append('</svg>')

    out_svg.parent.mkdir(parents=True, exist_ok=True)
    with open(out_svg, "w", encoding="utf-8") as f:
        f.write("\n".join(lines))


def main():
    parser = argparse.ArgumentParser(description="Standalone 2D Motion Trajectory Plotter")
    parser.add_argument("--input", required=True, type=Path, help="Path to MotionCorr STAR trajectory file")
    parser.add_argument("--out-dir", type=Path, default=Path("plots"), help="Output directory for plots")
    parser.add_argument("--title", type=str, default="MotionCorr 2D Motion Trajectory", help="Plot title")
    parser.add_argument("--format", nargs="+", default=["svg", "png"], choices=["svg", "png", "all"], help="Output formats")
    args = parser.parse_args()

    if not args.input.exists():
        print(f"Error: input file {args.input} does not exist.", file=sys.stderr)
        sys.exit(1)

    frames, shift_x, shift_y = parse_star_trajectory(args.input)
    if not frames:
        print(f"Error: no trajectory coordinates found in {args.input}", file=sys.stderr)
        sys.exit(1)

    print(f"[Trajectory Plotter] Extracted {len(frames)} frames from {args.input.name}")
    args.out_dir.mkdir(parents=True, exist_ok=True)
    stem = args.input.stem

    if "svg" in args.format or "all" in args.format:
        svg_path = args.out_dir / f"{stem}_trajectory.svg"
        plot_with_svg(args.title, frames, shift_x, shift_y, svg_path)
        print(f"[Trajectory Plotter] Generated SVG: {svg_path}")

    if "png" in args.format or "all" in args.format:
        png_path = args.out_dir / f"{stem}_trajectory.png"
        if plot_with_matplotlib(args.title, frames, shift_x, shift_y, png_path):
            print(f"[Trajectory Plotter] Generated PNG: {png_path}")
        else:
            print("[Trajectory Plotter] Matplotlib unavailable; SVG was generated as primary artifact.")


if __name__ == "__main__":
    main()
