+                    diff = max(abs(m[a]['angstrom'][k] - old[a]['angstrom'][k]) for a in ('runtime', 'STAR') for k in V3.LIMITS)
+                    record('retained pair %s/%s reproduces' % (case, arm), diff <= 1e-12, 'maxdiff_A=%.3g' % diff)
+                except Exception as e:
