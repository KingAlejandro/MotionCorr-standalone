### probe2 command
ssh 4GPUs 'cd ~/mc-startup-20261013 && cat > exitprobe.cu <<EOF
// Process with a context and a 128 MiB pinned buffer; PROBE_RESET=1 tears down explicitly.
#include <cuda_runtime.h>
#include <cstdlib>
int main() { cudaSetDevice(0); void *p; cudaHostAlloc(&p, 128u << 20, 0); void *d; cudaMalloc(&d, 1u << 30);
  if (getenv("PROBE_RESET")) { cudaFree(d); cudaFreeHost(p); cudaDeviceReset(); } return 0; }
EOF
/usr/local/cuda/bin/nvcc -O2 -o exitprobe exitprobe.cu 2>/dev/null && U0=$(nvidia-smi -i 0 --query-gpu=uuid --format=csv,noheader) && flock -w 600 /tmp/motioncorr-bench.lock taskset -c 96-103 bash -c "
echo COLD-all4visible; for i in 1 2 3; do ./probe time 0 128; sleep 1; done
echo COLD-CVD1; for i in 1 2 3; do CUDA_VISIBLE_DEVICES=$U0 ./probe time 0 128; sleep 1; done
echo COLD-CVD1-lazy-eager; CUDA_MODULE_LOADING=EAGER CUDA_VISIBLE_DEVICES=$U0 ./probe time 0 128; sleep 1
./probe hold 100 & H=\$!; sleep 3
echo WARM-CVD1; for i in 1 2 3; do CUDA_VISIBLE_DEVICES=$U0 ./probe time 0 128; done
echo EXIT-wall-implicit; for i in 1 2 3; do /usr/bin/time -f %e env CUDA_VISIBLE_DEVICES=$U0 ./exitprobe; done
echo EXIT-wall-explicit-reset; for i in 1 2 3; do /usr/bin/time -f %e env PROBE_RESET=1 CUDA_VISIBLE_DEVICES=$U0 ./exitprobe; done
kill \$H; wait" 2>&1'
