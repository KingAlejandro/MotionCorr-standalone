#!/home/alex/.mc-venv/bin/python
import hashlib,json,os,subprocess,sys,threading,time
from pathlib import Path
root=Path('/home/alex/mc118-preprocess-20260929T1311')
binary=root/'build/motioncorr_faultinject'
cmd=[str(binary),*sys.argv[1:],'--max_io_threads','2']
p=subprocess.Popen(cmd)
proc=Path('/proc')/str(p.pid)
for _ in range(100):
    if (proc/'exe').resolve()==binary.resolve():break
    time.sleep(.001)
else:
    p.kill();p.wait();raise RuntimeError('payload executable not witnessed')
row={'command':cmd,'pid':p.pid,'exe':str((proc/'exe').resolve()),'stat':(proc/'stat').read_text(),'status':(proc/'status').read_text(),'numa_maps':(proc/'numa_maps').read_text(),'cpus':sorted(os.sched_getaffinity(p.pid)),'cuda_visible_devices':os.environ['CUDA_VISIBLE_DEVICES'],'fault':os.environ['MC_U16_FAULT'],'gpu_samples':[]}
done=threading.Event()
def sample():
    while not done.is_set():
        s=subprocess.run(['nvidia-smi','--query-compute-apps=gpu_uuid,pid,process_name','--format=csv,noheader'],text=True,capture_output=True,timeout=15)
        row['gpu_samples'].append({'time':time.time(),'exit':s.returncode,'stdout':s.stdout,'stderr':s.stderr})
        done.wait(.05)
t=threading.Thread(target=sample);t.start()
try:
    rc=p.wait(timeout=180)
except subprocess.TimeoutExpired:
    p.kill();p.wait();raise
finally:
    done.set();t.join(timeout=20)
row['returncode']=rc
row['binary_sha256']=hashlib.file_digest(binary.open('rb'),'sha256').hexdigest()
row['physical_gpu_witness']=any(str(p.pid) in line and row['cuda_visible_devices'] in line for s in row['gpu_samples'] for line in s['stdout'].splitlines())
(root/'main-proof'/('u16-payload-'+row['fault']+'.json')).write_text(json.dumps(row,indent=2)+'\n')
assert row['cpus']==list(range(96,104)),row['cpus']
assert row['physical_gpu_witness'],'no physical GPU witness'
sys.exit(rc)
