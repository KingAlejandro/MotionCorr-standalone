### probe1 command
ssh 4GPUs 'cd ~/mc-startup-20261013 && flock -w 600 /tmp/motioncorr-bench.lock taskset -c 96-103 bash -c "
echo COLD; for i in 1 2 3 4 5; do ./probe time 0 128; sleep 1; done
echo COLD-huge; for i in 1 2 3; do ./probe time 0 128 huge; sleep 1; done
./probe hold 120 & H=\$!; sleep 3
echo WARM-holder; for i in 1 2 3 4 5; do ./probe time 0 128; sleep 1; done
echo WARM-huge; for i in 1 2 3; do ./probe time 0 128 huge; done
echo WARM-4concurrent; for d in 0 1 2 3; do ./probe time \$d 128 & done; wait %2 %3 %4 %5 2>/dev/null; sleep 1
kill \$H; wait
echo COLD-4concurrent; for d in 0 1 2 3; do ./probe time \$d 128 & done; wait
" 2>&1'
