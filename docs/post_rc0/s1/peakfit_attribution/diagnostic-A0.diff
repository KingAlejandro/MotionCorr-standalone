+                const float ax = std::abs(bx - fx), ay = std::abs(by - fy);
+                cx[f] = fx + ((h & 1u) ? ax : -ax);
+                cy[f] = fy + ((h & 2u) ? ay : -ay);
+                if (const char *path = std::getenv("MC_DIAG_NULL_RECORD")) {
